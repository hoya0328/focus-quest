# Browser-facing configuration for the isolated Focus Quest staging project.
E2E_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
E2E_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_OR_ANON_KEY

# Server-only staging credential. Never commit a real value.
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Guard rail: staging tests refuse to run when this URL matches E2E_SUPABASE_URL.
E2E_PRODUCTION_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co

# Optional. Omit to run the staging app locally at http://127.0.0.1:3200.
E2E_BASE_URL=
