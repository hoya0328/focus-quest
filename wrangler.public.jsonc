{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "focus-quest",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "vars": {
    "SUPABASE_URL": "https://uaqmmsuhnwupckakagmi.supabase.co"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
