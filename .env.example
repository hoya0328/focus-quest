# Public browser configuration. Do not put a Supabase service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Enable after the Google provider and redirect URLs are configured in Supabase.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Server-only. Leave empty to use the deterministic PDF analysis fallback.
# Never expose this value through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
