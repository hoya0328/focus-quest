# Public browser configuration. Do not put a Supabase service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Enable after the Google provider and redirect URLs are configured in Supabase.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Server-only account deletion configuration. Configure these as Cloudflare
# secrets/bindings; never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Legacy extension placeholders only. The current PDF guide/quiz path does not
# call OpenAI, even if these are populated. No paid AI feature is enabled here.
# Server-only: never expose an API key through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Browser-safe Web Push public key. The matching private key belongs only in
# Cloudflare Secret VAPID_PRIVATE_KEY and must never be committed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only Worker configuration for the operator dashboard. Exact Auth UUIDs,
# comma-separated; never use user-editable profile metadata or publish IDs here.
FOCUS_QUEST_OPERATOR_USER_IDS=
# Public Web Analytics site identifier, NOT a Cloudflare API token. Use Worker
# bindings; the application loads it only for optional, opt-in visit analytics.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
# Optional public ownership verification values from URL-prefix properties.
# Never enter a Google password, API key or Search Console OAuth token here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
