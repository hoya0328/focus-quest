{
  "name": "focus-quest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:public": "vite build",
    "deploy:public": "npm run build:public && wrangler deploy --config wrangler.public.jsonc",
    "start": "vinext start",
    "test": "npm run test:logic && npm run build && node --test tests/rendered-html.test.mjs",
    "test:logic": "node --test tests/pomodoro.test.mjs tests/pwa.test.mjs tests/cloud-state.test.mjs tests/public-auth.test.mjs",
    "test:account-sync": "node --test tests/cloud-state.test.mjs tests/public-auth.test.mjs",
    "test:quests": "node --test tests/study-quests.test.mjs tests/pomodoro.test.mjs",
    "test:pdf": "node --test tests/pdf-analysis.test.mjs tests/study-quests.test.mjs",
    "security:anonymous": "node scripts/security-anonymous.mjs",
    "lint": "eslint app lib tests scripts worker db examples vite.config.ts next.config.ts drizzle.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "pdfjs-dist": "^5.4.296",
    "phaser": "^3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.3.8",
    "wrangler": "4.160.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "baseline-browser-mapping": "2.11.0",
    "fflate": "0.8.3",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "type": "module"
}
