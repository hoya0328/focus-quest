    "/api/account": {
      "delete": {
        "operationId": "deleteAccount",
        "summary": "검증된 자기 계정과 연결 자료 삭제",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "있으면 요청 URL과 같은 origin이어야 한다. 인증을 대체하지 않는다.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "confirmation"
                ],
                "properties": {
                  "confirmation": {
                    "const": "delete-my-focus-quest-account"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "supabaseBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "deleted"
                  ],
                  "properties": {
                    "deleted": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "오류. HTTP 상태별 처리 계약은 API_CONTRACTS.md 참조.",
