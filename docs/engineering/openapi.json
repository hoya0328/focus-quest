    "/api/push-subscriptions": {
      "post": {
        "operationId": "savePushSubscription",
        "summary": "자기 출발 알림 구독 저장",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "있으면 요청 URL과 같은 origin이어야 한다. 인증을 대체하지 않는다.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subscription",
                  "reminderTime",
                  "timezone",
                  "nextDueAt"
                ],
                "properties": {
                  "subscription": {
                    "$ref": "#/components/schemas/PushSubscription"
                  },
                  "reminderTime": {
                    "type": "string",
                    "pattern": "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "description": "길이 검사만 수행. IANA 유효성 보증 아님."
                  },
                  "nextDueAt": {
                    "type": "string",
                    "description": "JavaScript Date.parse 가능 문자열."
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "supabaseBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "saved"
                  ],
                  "properties": {
                    "saved": {
                      "const": true
                    }
                  }
                }
              }
            }
