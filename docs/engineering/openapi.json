{
  "openapi": "3.1.0",
  "info": {
    "title": "Focus Quest HTTP contracts",
    "version": "1.0.0",
    "description": "코드 기준의 Worker API. 과목/클라우드/PDF/캠프 대부분은 Supabase 직접 연동이다. legacy 작업은 현재 공개 Worker에서 404."
  },
  "servers": [
    {
      "url": "https://focus-quest.hoya0328.workers.dev"
    },
    {
      "url": "http://127.0.0.1:3110",
      "description": "로컬 검증 예시; 실제 개발 포트는 서버 출력 확인"
    }
  ],
  "paths": {
    "/api/support": {
      "post": {
        "operationId": "submitSupportMemo", "summary": "로그인 없이 같은 Origin에서 비공개 문의 메모 접수", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["id", "category", "message", "consent", "noticeVersion"], "properties": { "id": { "type": "string", "format": "uuid" }, "category": { "enum": ["bug", "suggestion", "question"] }, "message": { "type": "string", "minLength": 10, "maxLength": 3000 }, "consent": { "const": true }, "noticeVersion": { "const": "2026-11-26.1" } } } } } },
        "responses": { "200": { "description": "접수 ID. 중복 재시도는 같은 ID 반환. 본문/타인 문의 없음." }, "400": { "description": "입력 또는 동의 오류" }, "403": { "description": "Origin 또는 cross-site 오류" }, "409": { "description": "접수 ID 충돌" }, "413": { "description": "16KiB body 초과" }, "429": { "description": "서버 접수 한도" }, "503": { "description": "서버 설정 또는 저장 실패" } }
      },
      "get": {
        "operationId": "getOperatorSupportInbox", "summary": "운영자만 최신 문의/접근 권한 확인", "security": [{ "supabaseBearer": [] }],
        "parameters": [{ "name": "cursor", "in": "query", "schema": { "type": "string" } }, { "name": "access", "in": "query", "schema": { "enum": ["1"] } }],
        "responses": { "200": { "description": "tickets/nextCursor 또는 allowed:true. private/no-store/noindex." }, "400": { "description": "잘못된 cursor" }, "401": { "description": "무인증/만료" }, "403": { "description": "비운영자" }, "503": { "description": "조회 실패" } }
      },
      "patch": {
        "operationId": "updateSupportStatus", "summary": "운영자만 문의 처리 상태 변경", "security": [{ "supabaseBearer": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["id", "status"], "properties": { "id": { "type": "string", "format": "uuid" }, "status": { "enum": ["open", "closed"] } } } } } },
        "responses": { "200": { "description": "updated:true" }, "400": { "description": "입력 오류" }, "401": { "description": "무인증/만료" }, "403": { "description": "비운영자 또는 Origin 오류" }, "404": { "description": "없거나 만료된 문의" }, "503": { "description": "갱신 실패" } }
      }
    },
    "/api/operations": {
      "get": {
        "operationId": "getOperationsDashboard",
        "summary": "서버 allowlist 운영자에게만 내용 없는 이용 집계 제공",
        "security": [{ "supabaseBearer": [] }],
        "parameters": [{ "name": "days", "in": "query", "schema": { "type": "integer", "enum": [7, 30], "default": 7 } }],
        "responses": {
          "200": { "description": "KST 기간, summary, daily, companions. 계정 ID·개별 이벤트 없음. no-store/noindex." },
          "400": { "description": "7/30 이외 기간" },
          "401": { "description": "무인증 또는 검증 실패" },
          "403": { "description": "비운영자 또는 Origin 불일치" },
          "503": { "description": "서버 설정·조회 실패·안전 한도 초과. 부분 집계 없음." }
        }
      }
    },
    "/api/visit-analytics": {
      "get": {
        "operationId": "getPublicVisitAnalyticsConfig",
        "summary": "선택형 방문 분석의 공개 사이트 식별자 제공",
        "security": [],
        "responses": { "200": { "description": "enabled boolean, 활성일 때만 공개 token. 관리자 API 키 아님. no-store/noindex." } }
      }
    },
    "/robots.txt": {
      "get": {
        "operationId": "getRobotsInstructions",
        "summary": "공개 검색 지침과 사이트맵 주소",
        "security": [],
        "responses": { "200": { "description": "text/plain. 검색 지침은 인증이나 색인 보장이 아님." } }
      }
    },
    "/sitemap.xml": {
      "get": {
        "operationId": "getPublicSitemap",
