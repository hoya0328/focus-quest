      "supabaseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase access token"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "account/legacy 응답의 선택 값. 공통 추적은 응답 헤더."
          }
        }
      },
      "PushSubscription": {
        "type": "object",
        "required": [
          "endpoint",
          "keys"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^https://"
          },
          "keys": {
            "type": "object",
            "required": [
              "auth",
              "p256dh"
            ],
            "properties": {
              "auth": {
                "type": "string",
                "minLength": 8,
                "maxLength": 80
              },
              "p256dh": {
                "type": "string",
                "minLength": 40,
                "maxLength": 180
              }
            }
          }
        }
      }
    }
  }
}
